#!/bin/sh
set -eu

machine=${1:?usage: mail-authinfo-password MACHINE LOGIN}
login=${2:?usage: mail-authinfo-password MACHINE LOGIN}

authinfo=$(gpg --quiet --batch --decrypt "$HOME/.authinfo.gpg") || {
  printf 'mail-authinfo-password: failed to decrypt ~/.authinfo.gpg\n' >&2
  exit 1
}

line=$(
  printf '%s\n' "$authinfo" |
    awk -v machine="$machine" -v login="$login" '
      {
        found_machine = 0
        found_login = 0
        for (i = 1; i <= NF; i++) {
          if ($i == "machine" && $(i + 1) == machine)
            found_machine = 1
          if ($i == "login" && $(i + 1) == login)
            found_login = 1
        }
        if (found_machine && found_login) {
          print
          exit
        }
      }
    '
)

case "$line" in
  *' password "'*)
    password=${line#* password \"}
    password=${password%%\"*}
    ;;
  *' password '*)
    password=${line#* password }
    password=${password%% *}
    ;;
  *)
    password=
    ;;
esac

if [ -z "$password" ]; then
  printf 'mail-authinfo-password: no password found for %s %s\n' "$machine" "$login" >&2
  exit 1
fi

printf '%s\n' "$password"
