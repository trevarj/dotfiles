#!/usr/bin/env sh
#
# Dispatch user-service actions to Shepherd under Guix Home or systemd --user
# under Home Manager. Niri itself owns the topbar process on both.
#
#   svc <action> <service>...  forward an action (start/stop/restart/status)
#   svc session-start          hand the Wayland session env to the supervisor,
#                              then bring up the graphical daemons
#
set -eu

# Niri starts topbar; the supervisor starts the remaining graphical services.
SESSION_DAEMONS='hypridle awww-normal awww-overview'

# Variables niri only sets once the session is up. Shepherd is started at login,
# long before that, so it never inherits them and its children would otherwise
# come up with no display to attach to.
SESSION_ENV='WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_RUNTIME_DIR NIRI_SOCKET DISPLAY'

have() {
	command -v "$1" >/dev/null 2>&1
}

# Shepherd can be installed but not running this session, so probe the socket
# rather than just the binary.
using_shepherd() {
	have herd && herd status >/dev/null 2>&1
}

using_systemd() {
	have systemctl && systemctl --user show-environment >/dev/null 2>&1
}

no_supervisor() {
	echo "svc: no user service manager found" >&2
	exit 127
}

# Shepherd has no import-environment, but its root service evaluates arbitrary
# Scheme, so push each variable in with setenv.
shepherd_import_env() {
	for var in $SESSION_ENV; do
		eval "value=\${$var-}"
		[ -n "$value" ] || continue
		escaped=$(printf '%s' "$value" | sed 's/\\/\\\\/g; s/"/\\"/g')
		herd eval root "(setenv \"$var\" \"$escaped\")" >/dev/null
	done
}

restart_niri_topbar() {
	lock="${XDG_RUNTIME_DIR:?svc: XDG_RUNTIME_DIR is required}/topbar.lock"
	# ponytail: the existing lock identifies the daemon; leave CLI and app PIDs alone.
	for pid in $(pgrep -u "$(id -u)" -x 'topbar|\.topbar-wrapped' || :); do
		for fd in /proc/"$pid"/fd/*; do
			if [ "$fd" -ef "$lock" ]; then
				kill "$pid"
				break
			fi
		done
	done
	# The lock is released on exit; spawning sooner can lose to the old panel.
	flock -w 5 "$lock" true || {
		echo "svc: timed out waiting for topbar to exit" >&2
		return 1
	}
	niri msg action spawn -- topbar
}

session_start() {
	if using_shepherd; then
		shepherd_import_env
		for unit in $SESSION_DAEMONS; do
			herd start "$unit" >/dev/null ||
				echo "svc: failed to start $unit" >&2
		done
	elif using_systemd; then
		# Home Manager binds these to graphical-session.target, so this is
		# normally a no-op; it stays here so both hosts take the same path.
		# shellcheck disable=SC2086
		systemctl --user import-environment $SESSION_ENV
		for unit in $SESSION_DAEMONS; do
			systemctl --user start "$unit" ||
				echo "svc: failed to start $unit" >&2
		done
	else
		no_supervisor
	fi
	niri msg action spawn -- topbar
}

action=${1-}

case $action in
session-start)
	session_start
	;;
'' | -h | --help)
	echo "usage: svc <action> <service>... | svc session-start" >&2
	[ -n "$action" ] && exit 0 || exit 2
	;;
*)
	shift
	[ $# -gt 0 ] || {
		echo "usage: svc $action <service>..." >&2
		exit 2
	}
	if using_shepherd; then
		if [ "$action" = restart ] && [ "$#" -eq 1 ] && [ "$1" = topbar ]; then
			restart_niri_topbar
			exit
		fi
		for unit in "$@"; do
			herd "$action" "$unit"
		done
	elif using_systemd; then
		if [ "$action" = restart ] && [ "$#" -eq 1 ] && [ "$1" = topbar ]; then
			restart_niri_topbar
		else
			systemctl --user "$action" "$@"
		fi
	else
		no_supervisor
	fi
	;;
esac
