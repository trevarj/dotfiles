#!/usr/bin/env bash
# Capture only through Mango's native protocols; never crop around a denied toplevel.
set -euo pipefail
umask 077

case ${1-} in
	region|output|window) mode=$1 ;;
	*) echo 'usage: mango-screenshot region|output|window' >&2; exit 2 ;;
esac
[[ $# == 1 ]] || { echo 'usage: mango-screenshot region|output|window' >&2; exit 2; }

fail() {
	echo "mango-screenshot: $*" >&2
	notify-send -u critical 'Screenshot failed' "$*" 2>/dev/null || :
	exit 1
}

for command in grim wl-copy jq; do
	command -v "$command" >/dev/null || fail "$command is required"
done
if [[ $mode == region ]]; then
	command -v slurp >/dev/null || fail 'slurp is required'
	command -v satty >/dev/null || fail 'satty is required'
else
	command -v mmsg >/dev/null || fail 'mmsg is required'
fi

directory=$HOME/Pictures/Screenshots
mkdir -p -- "$directory" || fail "Could not create $directory"
staging=$(mktemp -d "$directory/.mango-screenshot.XXXXXXXX") || fail 'Could not create private capture staging'
keep=0
trap 'if [[ $keep == 0 ]]; then rm -rf -- "$staging"; fi' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
image=$staging/capture.png

case $mode in
	region)
		# Slurp reports Escape as nonzero: cancellation is a normal no-op.
		geometry=$(slurp) || exit 0
		[[ -n $geometry ]] || exit 0
		grim -g "$geometry" "$image" || fail 'Region capture failed'
		[[ -s $image ]] || fail 'Region capture produced no image'
		image=$staging/annotated.png
		satty --filename "$staging/capture.png" --output-filename "$image" \
			--copy-command 'wl-copy --type image/png' --save-after-copy --early-exit \
			--actions-on-enter save-to-clipboard --actions-on-escape exit \
			--disable-notifications || fail 'Screenshot editor failed'
		# Escape closes the editor without its output file.
		[[ -e $image ]] || exit 0
		;;
	output)
		output=$(mmsg get all-monitors | jq -er '
			if has("error") then error(.error) else .monitors end
			| if type == "array" then . else error("missing monitors") end
			| [.[] | select(.active == true) | .name]
			| if length == 1 then .[0] else error("no unique focused output") end
			| select(type == "string" and length > 0)') || fail 'Could not find the focused output'
		grim -o "$output" "$image" || fail 'Output capture failed'
		;;
	window)
		identifier=$(mmsg get focusing-client | jq -er '
			if has("error") then error(.error) else .foreign_toplevel_id end
			| select(type == "string" and length > 0)') || fail 'Could not find the focused window'
		grim -T "$identifier" "$image" || fail 'Focused-window capture failed (capture may be protected)'
		;;
esac
[[ -s $image ]] || fail 'Capture produced no image'

destination=$directory/Screenshot_from_$(date +%Y-%m-%d_%H-%M-%S_%N).png
# A same-filesystem hard link publishes atomically and cannot overwrite a capture.
if ! ln -T -- "$image" "$destination"; then
	keep=1
	fail "Could not publish $destination; completed image preserved at $image"
fi
wl-copy --type image/png < "$destination" || fail "Saved $destination, but copying to the clipboard failed"
notify-send 'Screenshot saved' "$destination" 2>/dev/null || :
printf '%s\n' "$destination"
