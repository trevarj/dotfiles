#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
normal_namespace="${WALLPAPER_NORMAL_NAMESPACE:-normal}"
overview_namespace="${WALLPAPER_OVERVIEW_NAMESPACE:-overview}"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper"
cache_dir="$cache_root/blurred"
current_wallpaper="$cache_root/current.png"
current_blurred="$cache_root/current-blurred.png"
blur_radius="${WALLPAPER_BLUR_RADIUS:-0x18}"
tint="${WALLPAPER_TINT:-}"
refresh=false
selected_file=""

render_notified=false
notification_id=""

notify_rendering() {
  if ! $render_notified; then
    render_notified=true
    if command -v notify-send >/dev/null 2>&1; then
      notification_id="$(notify-send --print-id --expire-time=30000 "Rendering wallpaper" 2>/dev/null)" || notification_id=""
    fi
  fi
}

die() {
  printf 'wallpaper-random: %s\n' "$*" >&2
  exit 1
}

check_pointers() {
  for pointer in "$current_wallpaper" "$current_blurred"; do
    [[ ! -e "$pointer" || -L "$pointer" ]] || die "$pointer is not a symlink"
  done
}

if [[ $# -eq 1 && "$1" == "--refresh" ]]; then
  refresh=true
elif [[ $# -eq 2 && "$1" == "--file" ]]; then
  [[ -n "$2" ]] || die "wallpaper path is empty"
  selected_file="$2"
elif [[ $# -gt 0 ]]; then
  die "usage: wallpaper-random [--refresh | --file PATH]"
fi

command -v awww >/dev/null 2>&1 || die "awww is not on PATH"
[[ -d "$wallpaper_dir" ]] || die "$wallpaper_dir does not exist"
check_pointers

current=""
if [[ -f "$current_wallpaper" ]]; then
  current="$(readlink -f "$current_wallpaper")"
fi

if [[ -n "$selected_file" ]]; then
  # Validate the pool entry, while allowing its image to be a symlink.
  [[ -f "$selected_file" ]] || die "$selected_file is not a wallpaper file"
  case "${selected_file,,}" in
    *.jpg|*.jpeg|*.png|*.webp) ;;
    *) die "$selected_file is not a supported wallpaper image" ;;
  esac
  pool_dir="$(readlink -f -- "$wallpaper_dir")"
  selected_parent="$(readlink -f -- "$(dirname -- "$selected_file")")"
  [[ "$selected_parent" == "$pool_dir" || "$selected_parent" == "$pool_dir/"* ]] ||
    die "$selected_file is outside $wallpaper_dir"
  wallpaper="$(readlink -f -- "$selected_file")"
elif $refresh; then
  [[ -n "$current" ]] || die "no current wallpaper cache exists; run wallpaper-random first"
  wallpaper="$current"
else
  shopt -s nullglob globstar nocaseglob
  wallpapers=()
  current_in_pool=false
  for path in "$wallpaper_dir"/**/*.jpg "$wallpaper_dir"/**/*.jpeg "$wallpaper_dir"/**/*.png "$wallpaper_dir"/**/*.webp; do
    [[ -f "$path" ]] || continue
    path="$(readlink -f "$path")"
    if [[ "$path" == "$current" ]]; then
      current_in_pool=true
    else
      wallpapers+=("$path")
    fi
  done

  if ((${#wallpapers[@]} > 0)); then
    wallpaper="${wallpapers[RANDOM % ${#wallpapers[@]}]}"
  elif $current_in_pool; then
    wallpaper="$current"
  else
    die "no supported wallpapers found in $wallpaper_dir"
  fi
fi

if command -v magick >/dev/null 2>&1; then
  convert_cmd=(magick)
elif command -v convert >/dev/null 2>&1; then
  convert_cmd=(convert)
else
  die "ImageMagick is not on PATH"
fi

mkdir -p "$cache_dir"

mtime="$(stat -c %y "$wallpaper")"
size="$(stat -c %s "$wallpaper")"
tmp_dir="$(mktemp -d "$cache_root/.wallpaper.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
rendered="$wallpaper"

if [[ -n "$tint" ]]; then
  tint_key="$(printf '%s\0%s\0%s\0%s' "$wallpaper" "$mtime" "$size" "$tint" | sha256sum | cut -d ' ' -f 1)"
  tinted="$cache_root/tinted/$tint_key.png"
  if [[ ! -f "$tinted" ]]; then
    notify_rendering
    "${convert_cmd[@]}" "$wallpaper" -auto-orient -fill "$tint" -colorize 20 "PNG:$tmp_dir/tinted.png"
    mkdir -p "$cache_root/tinted"
    mv -T "$tmp_dir/tinted.png" "$tinted"
  fi
  rendered="$(readlink -f "$tinted")"
fi

cache_key="$(printf '%s\0%s\0%s\0%s' "$rendered" "$mtime" "$size" "$blur_radius" | sha256sum | cut -d ' ' -f 1)"
blurred="$cache_dir/$cache_key.png"

if [[ ! -f "$blurred" ]]; then
  notify_rendering
  "${convert_cmd[@]}" "$rendered" -auto-orient -resize 3840x2160^ -gravity center -extent 3840x2160 -blur "$blur_radius" "PNG:$tmp_dir/blurred.png"
  mv -T "$tmp_dir/blurred.png" "$blurred"
fi

if [[ -n "$notification_id" ]]; then
  notify-send --replace-id="$notification_id" --expire-time=2000 "Wallpaper rendered" >/dev/null 2>&1 || true
fi

blurred="$(readlink -f "$blurred")"

awww img -n "$normal_namespace" --resize crop "$rendered"

check_pointers
ln -s "$wallpaper" "$tmp_dir/current.png"
ln -s "$blurred" "$tmp_dir/current-blurred.png"
mv -Tf "$tmp_dir/current.png" "$current_wallpaper"
mv -Tf "$tmp_dir/current-blurred.png" "$current_blurred"

# Treat a missing overview daemon as the user's one-line blur disable in niri.
if ! awww query -n "$overview_namespace" >/dev/null 2>&1; then
  exit 0
fi

awww img -n "$overview_namespace" --resize crop "$blurred" -t fade --transition-duration 1
