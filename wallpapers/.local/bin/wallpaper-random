#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
normal_namespace="${WALLPAPER_NORMAL_NAMESPACE:-normal}"
overview_namespace="${WALLPAPER_OVERVIEW_NAMESPACE:-overview}"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper"
cache_dir="$cache_root/blurred"
current_wallpaper="$cache_root/current.png"
current_blurred="$cache_root/current-blurred.png"
blur_radius="${WALLPAPER_BLUR_RADIUS:-0x18}"
refresh=false

die() {
  printf 'wallpaper-random: %s\n' "$*" >&2
  exit 1
}

check_pointers() {
  for pointer in "$current_wallpaper" "$current_blurred"; do
    [[ ! -e "$pointer" || -L "$pointer" ]] || die "$pointer is not a symlink"
  done
}

if [[ $# -eq 1 && "$1" == "--refresh" ]]; then
  refresh=true
elif [[ $# -gt 0 ]]; then
  die "usage: wallpaper-random [--refresh]"
fi

command -v awww >/dev/null 2>&1 || die "awww is not on PATH"
[[ -d "$wallpaper_dir" ]] || die "$wallpaper_dir does not exist"
check_pointers

current=""
if [[ -f "$current_wallpaper" ]]; then
  current="$(readlink -f "$current_wallpaper")"
fi

if $refresh; then
  [[ -n "$current" ]] || die "no current wallpaper cache exists; run wallpaper-random first"
  wallpaper="$current"
else
  shopt -s nullglob globstar nocaseglob
  wallpapers=()
  current_in_pool=false
  for path in "$wallpaper_dir"/**/*.jpg "$wallpaper_dir"/**/*.jpeg "$wallpaper_dir"/**/*.png "$wallpaper_dir"/**/*.webp; do
    [[ -f "$path" ]] || continue
    path="$(readlink -f "$path")"
    if [[ "$path" == "$current" ]]; then
      current_in_pool=true
    else
      wallpapers+=("$path")
    fi
  done

  if ((${#wallpapers[@]} > 0)); then
    wallpaper="${wallpapers[RANDOM % ${#wallpapers[@]}]}"
  elif $current_in_pool; then
    wallpaper="$current"
  else
    die "no supported wallpapers found in $wallpaper_dir"
  fi
fi

if command -v magick >/dev/null 2>&1; then
  convert_cmd=(magick)
elif command -v convert >/dev/null 2>&1; then
  convert_cmd=(convert)
else
  die "ImageMagick is not on PATH"
fi

mkdir -p "$cache_dir"

mtime="$(stat -c %Y "$wallpaper")"
size="$(stat -c %s "$wallpaper")"
cache_key="$(printf '%s\0%s\0%s\0%s' "$wallpaper" "$mtime" "$size" "$blur_radius" | sha256sum | cut -d ' ' -f 1)"
blurred="$cache_dir/$cache_key.png"
tmp_dir="$(mktemp -d "$cache_root/.wallpaper.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT

if [[ ! -f "$blurred" ]]; then
  "${convert_cmd[@]}" "$wallpaper" -auto-orient -resize 3840x2160^ -gravity center -extent 3840x2160 -blur "$blur_radius" "PNG:$tmp_dir/blurred.png"
  mv -T "$tmp_dir/blurred.png" "$blurred"
fi

blurred="$(readlink -f "$blurred")"

awww img -n "$normal_namespace" --resize crop "$wallpaper"

check_pointers
ln -s "$wallpaper" "$tmp_dir/current.png"
ln -s "$blurred" "$tmp_dir/current-blurred.png"
mv -Tf "$tmp_dir/current.png" "$current_wallpaper"
mv -Tf "$tmp_dir/current-blurred.png" "$current_blurred"

# Treat a missing overview daemon as the user's one-line blur disable in niri.
if ! awww query -n "$overview_namespace" >/dev/null 2>&1; then
  exit 0
fi

awww img -n "$overview_namespace" --resize crop "$blurred" -t fade --transition-duration 1
