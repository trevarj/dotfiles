{
  "layer": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": [
    "niri/workspaces",
    "custom/crypto",
  ],
  "modules-center": [
    "custom/weather",
    "clock",
    "custom/swaync"
  ],
  "modules-right": [
    "tray",
    "privacy",
    "niri/language",
    "custom/headset",
    "pulseaudio",
    "bluetooth",
    "network",
    "temperature",
    "memory",
    "battery",
    "group/settings"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      // "browser": "",
      // "emacs": "",
      // "chat": "",
      "active": "███████",
      "default": ""
    },
    "disable-click": false,
    "disable-markup": false,
    "current-only": false,
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down",
    "on-click-backward": "niri msg action focus-column-left",
    "on-click-forward": "niri msg action focus-column-right"
  },
  "niri/language": {
    "format-en": "en",
    "format-ru": "ru"
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "format": "{:%A, %b %d  %H:%M}",
    "tooltip-format": "{tz_list}",
    "timezone-tooltip-format": "{:%A, %b %d  %H:%M %Z}",
    "on-click": "swaync-client -t",
    "timezones": [
      "",
      "America/New_York",
      "Etc/UTC",
    ],
  },
  "memory": {
    "format": "",
    "states": {
        "warning": 80,
        "critical": 95
    },
    "format-warning": "󰍛",
    "format-critical": "󰍛",
    "tooltip-format": "{used:0.1f}GiB/{total:0.1f}GiB"
  },
  "temperature": {
    "thermal-zone": 0,
    "warning-threshold": 75,
    "critical-threshold": 85,
    "format": "",
    "format-warning": "{icon}",
    "format-critical": "{icon} {temperatureC}°C",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󱟢 {capacity}%",
    "format-alt": "{icon}  {time}",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹",
    ]
  },
  "network": {
    "format": "{icon}",
    "format-icons": {
      "wifi": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "ethernet": [
        "󰌗"
      ],
      "disconnected": [
        "󰤮"
      ]
    },
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{ifname} {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty -e nmtui",
    "on-click-right": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {format_source}",
    "format-bluetooth": "{icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": "󰖁",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{volume}% {desc}",
    "on-click": "pavucontrol"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "",
    "format-disabled": "",
    "format-connected": "󰂯",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}, {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 18,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ],
    "ignore": [
      {
        "type": "audio-in",
        "name": "cava"
      },
      {
        "type": "screenshare",
        "name": "obs"
      }
    ]
  },
  "custom/crypto": {
    "exec": "$HOME/.config/waybar/scripts/crypto.sh -r",
    "interval": 1800,
    "format": "{}",
    "tooltip": "",
    "hide-empty-text": true
  },
  "custom/weather": {
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "interval": 1800,
    "signal": 1,
    "format": "{}",
    "tooltip": "",
    "on-click-right": "sh -c 'if grep -q F /tmp/waybar-weather-unit 2>/dev/null; then echo C > /tmp/waybar-weather-unit; else echo F > /tmp/waybar-weather-unit; fi; pkill -SIGRTMIN+1 waybar'"
  },
  "custom/headset": {
    "exec": "$HOME/.config/waybar/scripts/headsetcontrol.sh",
    "interval": 5,
    "format": "{text}",
    "tooltip-format": "{percentage}%",
    "return-type": "json",
    "hide-empty-text": true,
  },
  "custom/swaync": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "group/settings": {
    "orientation": "inherit",
    "modules": [
      "custom/settings",
      "custom/power",
      "custom/reboot",
      "custom/suspend",
      "custom/lock",
      "idle_inhibitor",
    ],
    "drawer": {
      "children-class": "not-settings",
      "transition-duration": 500,
      "transition-left-to-right": false,
      "click-to-reveal": false
    }
  },
  "custom/settings": {
    "format": " ",
    "tooltip": false
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "loginctl poweroff"
  },
  "custom/suspend": {
    "format": "󰤄",
    "tooltip": false,
    "on-click": "loginctl suspend"
  },
  "custom/reboot": {
    "format": "󰜉",
    "tooltip": false,
    "on-click": "loginctl reboot"
  },
  "custom/lock": {
    "format": "󰍁",
    "tooltip": false,
    "on-click": "hyprlock"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰒳",
      "deactivated": "󰒲"
    }
  }
}
