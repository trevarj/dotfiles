#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../.." && pwd)"
output="${1:-$repo_root/stinkpad-installer.iso}"
target_root="$repo_root/stinkpad-target-system"
closure_archive="${TMPDIR:-/tmp}/stinkpad-target-system.nar"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

command -v guix >/dev/null 2>&1 || die "missing required command: guix"
command -v readlink >/dev/null 2>&1 || die "missing required command: readlink"

cd "$repo_root"

printf 'Building target Guix System closure.\n' >&2
guix system build -L . \
  -r "$target_root" \
  trev-guix/systems/install-target.scm

printf 'Exporting target Guix System closure to %s.\n' "$closure_archive" >&2
guix archive --export -r "$(readlink -f "$target_root")" > "$closure_archive"

printf 'Building installer ISO at %s.\n' "$output" >&2
STINKPAD_TARGET_CLOSURE_ARCHIVE="$closure_archive" \
  guix system image -L . -t iso9660 \
  -r "$output" \
  -e '(@ (trev-guix systems installer) %stinkpad-installer)'

printf 'Installer ISO ready: %s\n' "$output" >&2
